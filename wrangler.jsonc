{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meal-plan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Eigene Domain (Zone miyummy.com in diesem Cloudflare-Konto); www leitet der Worker auf miyummy.com um.
  // Die workers.dev-Adresse bleibt zusätzlich erreichbar.
  "routes": [
    { "pattern": "miyummy.com", "custom_domain": true },
    { "pattern": "www.miyummy.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
